 http }\nexport default axios\n","export enum HostEnum {\n    GLOBAL,\n    HK,\n    TW\n}","import { HostEnum } from '@app/constants/OverseasEnum'\n\nconst GetRequest = () => {\n  const url = location.search //获取url中\"?\"符后的字串\n  // const theRequest = new Object();\n  const theRequest: any = {}\n  if (url.indexOf('?') != -1) {\n    const str = url.substr(1)\n    const strs = str.split('&')\n    for (let i = 0; i < strs.length; i++) {\n      theRequest[strs[i].split('=')[0]] = decodeURIComponent(strs[i].split('=')[1])\n    }\n  }\n  return theRequest\n}\n\n// 获取host\nconst urlHost = window.location.host\nconst urlType = urlHost.split('.')[0]\nlet overseasHost = HostEnum.GLOBAL\nif (urlType.indexOf('hk') > -1) {\n  overseasHost = HostEnum.HK\n} else if (urlType.indexOf('tw') > -1) {\n  overseasHost = HostEnum.TW\n}\n\nexport const OVERSEAS_HOST = overseasHost\n\n//判断字体需要\nconst GetUrlHostType = () => {\n  // let urlReg = /[a-zA-Z0-9][-a-zA-Z0-9]{0,62}(.[a-zA-Z0-9][-a-zA-Z0-9]{0,62})+.?/\n  // let url: any = urlReg.exec(urlHost)\n  if (OVERSEAS_HOST == HostEnum.HK || OVERSEAS_HOST == HostEnum.TW) {\n    return 'complexFont'\n  } else {\n    return 'simplifiedFont'\n  }\n}\n//判断埋点需要\nexport function GetClstagType() {\n  if (OVERSEAS_HOST == HostEnum.HK) {\n    return 'hk'\n  } else if (OVERSEAS_HOST == HostEnum.TW) {\n    return 'taiwan'\n  } else {\n    return 'global'\n  }\n}\n\nexport function getPvid() {\n  let d = new Date().getTime()\n  const uuid = 'xxxxxxxxxxxx4xxxyxxxxxxxxxxxxxxx'.replace(/[xy]/g, function (c) {\n    const r = (d + Math.random() * 16) % 16 | 0\n    d = Math.floor(d / 16)\n    return (c == 'x' ? r : (r & 0x3) | 0x8).toString(16)\n  })\n  return uuid\n}\n\nexport function filterTrim(str) {\n  return str ? str.replace(/\\s/g, '') : str\n}\n\nconst toFixed = (num, digit) => {\n  try {\n    num = parseFloat(num)\n  } catch (e) {\n    num = 0\n  }\n  return num.toFixed(digit)\n}\n\nconst onlyDecimal = (num, digit) => {\n  const str = toFixed(num, digit)\n  return str.split('.')[1]\n}\n\nconst onlyInteger = (num) => {\n  const str = toFixed(num, 2)\n  return str.split('.')[0]\n}\n\nexport function getCookie(name: string) {\n  const arr = document.cookie.match(new RegExp(`(^| )${name}=([^;]*)(;|$)`))\n  if (arr != null) {\n    return arr[2]\n  }\n  return ''\n}\n\nexport function getPin() {\n  const pin = getCookie('pin') || ''\n  return pin\n}\n\nexport function getUuid() {\n  // 优先取__jda的第二位，其次取__jdu\n  let uuid = ''\n  try {\n    uuid = getCookie('__jda') ? getCookie('__jda').split('.')[1] : ''\n    if (!uuid) {\n      uuid = getCookie('__jdu')\n    }\n    return uuid\n  } catch (err) {\n    return ''\n  }\n}\n\n// 节流函数\nexport function throttle(fn: any, threshhold: number, scope?: any) {\n  threshhold || (threshhold = 30)\n  let last: any = 0\n  let timer: any\n  return function (...args: any[]) {\n    //@ts-ignore\n    const context = scope || this\n    const now = +new Date()\n    //@ts-ignore\n    if (now - last < threshhold) {\n      // 如果两次调用的间隔小于指定的时间周期，则清除上一次的调用并设定新的调用\n      clearTimeout(timer)\n      timer = setTimeout(function () {\n        last = now\n        fn.apply(context, args as any)\n      }, threshhold)\n    } else {\n      last = now\n    }\n  }\n}\n\nexport function throwError(url, fid, error, params) {\n  try {\n    window.jmfe.jsagentReport(window.jmfe.JSAGENT_EXCEPTION_TYPE.business, 700, `接口异常-${url}`, {\n      fid: fid ? fid : url,\n      error: JSON.stringify(error),\n      params: JSON.stringify(params),\n    })\n  } catch (error) {\n    console.log(error)\n  }\n}\n\n/**\n * 防抖函数工具\n * @param func 需要防抖的函数\n * @param delay 延迟时间（毫秒）\n * @returns 返回防抖处理后的函数\n */\nexport function debounce<T extends (...args: any[]) => void>(func: T, delay: number): T & { cancel: () => void } {\n  let timeoutId: NodeJS.Timeout | null = null\n\n  const debouncedFunction = function (this: any, ...args: Parameters<T>) {\n    // 清除之前的定时器\n    if (timeoutId !== null) {\n      clearTimeout(timeoutId)\n    }\n\n    // 设置新的定时器\n    timeoutId = setTimeout(() => {\n      func.apply(this, args)\n      timeoutId = null\n    }, delay)\n  } as T & { cancel: () => void }\n\n  // 添加取消方法\n  debouncedFunction.cancel = () => {\n    if (timeoutId !== null) {\n      clearTimeout(timeoutId)\n      timeoutId = null\n    }\n  }\n\n  return debouncedFunction\n}\n\nexport default { GetRequest, GetUrlHostType, GetClstagType, onlyDecimal, onlyInteger, getCookie, throttle, debounce }\n","type ValObj = Record<string, string | number | boolean>\n\ntype WithExtra<T> = T & {\n  extra?: { [key: string]: any };\n};\n\n/**\n * 监控标识 和烛龙上对应\n * */\nexport enum PointName {\n  // 请求数据异常上报\n  request_exception = 'request_exception',\n  // 页面显示异常上报\n  page_exception = 'page_exceptipn'\n}\n\n/**\n * 异常码\n * */\nexport enum PointCode {\n  // 搜索区域\n  Search = 750,\n  // 菜单区域\n  Menu = 751,\n  // 轮播区域\n  Banner = 752,\n  // 用户信息区域\n  Members = 753,\n  // 促销区域\n  Promote = 754,\n  // 频道广场区域\n  ChannelSquare = 755,\n  // 推荐区域\n  Recommend = 756,\n  // 顶部区域\n  ActivityTop = 757,\n  // 其他\n  Other = 758\n}\n\n/**\n * 埋点标识 request_exception 对应 context 类型\n * */\nexport type RequestExceptionContext = {\n  // 网关接口名称\n  functionId: string\n  // 上报码\n  code: PointCode\n  // 请求参数\n  request: string\n  // 异常信息\n  error_msg: string\n  // 异常code码区分\n  error_code: PointCode\n  // 异常类型文案\n  error_type_txt: string\n  // ajax状态码\n  http_status?: string\n  // 响应参数\n  response?: string\n  // 上报信息\n  msg?: string\n}\n\n/**\n * 埋点标识 page_exception 对应 context 类型\n * */\nexport type PageExceptionContext = {\n  // 上报码\n  code: PointCode\n  // 异常信息\n  error_msg: string\n  // 异常code码区分\n  error_code: PointCode\n  // 异常数据\n  error_data: string\n}\n\ntype CustomPayload = WithExtra<{\n  // name: 埋点标识，用于区分业务\n  name: PointName;\n  // metrics 字段可被聚合统计处理，用来进行告警、环比等操作\n  metrics: ValObj;\n  // context 字段仅做上下文备注，可用来筛选、过滤等操作\n  context?: ValObj;\n}>;\n\ntype Payload<T> = Omit<CustomPayload, 'metrics' | 'context'> & {\n  context: T\n}\n\ntype D